# =============================================================================
# OwnClaw Production Environment Configuration
# =============================================================================
# Copy this file to /opt/ownclaw/.env and fill in the values.
# This file is loaded by the systemd service (EnvironmentFile).
# Permissions should be 600 (only ownclaw user can read):
#   chmod 600 /opt/ownclaw/.env
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — GitHub Token (for auto-deploy to pull from private/public repo)
# ---------------------------------------------------------------------------

# Fine-grained Personal Access Token with Contents:read permission.
# Generate at: https://github.com/settings/tokens?type=beta
# Select the ownclaw repo, grant "Contents: Read-only" under Repository permissions.
GITHUB_TOKEN=github_pat_...

# ---------------------------------------------------------------------------
# REQUIRED — LLM API Keys
# ---------------------------------------------------------------------------

# OpenAI API key (used by the Mentor LLM — GPT-4o)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ---------------------------------------------------------------------------
# OPTIONAL — MCP Servers
# ---------------------------------------------------------------------------

# Brave Search API key for the MCP brave-search server.
# Required only when using the 'brave-search' MCP server for web search.
# Get a free key at: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# OPTIONAL — Telegram Bot
# ---------------------------------------------------------------------------

# To enable the Telegram interface, create a bot via @BotFather on Telegram,
# then paste the token here and set OWNCLAW_TELEGRAM_ENABLED=true.
# TELEGRAM_BOT_TOKEN=123456789:AABBccDD-EeFfGgHhIiJjKkLlMmNnOoPp
# OWNCLAW_TELEGRAM_ENABLED=true

# ---------------------------------------------------------------------------
# OPTIONAL — Server
# ---------------------------------------------------------------------------

# HTTP port (default: 8080)
# OWNCLAW_SERVER_PORT=8080

# ---------------------------------------------------------------------------
# OPTIONAL — Ollama (Executor LLM)
# ---------------------------------------------------------------------------
# If Ollama runs on a different host or port, override these.
# On the production server you need Ollama installed and running separately.
#
# Install Ollama:  curl -fsSL https://ollama.com/install.sh | sh
# Pull the model:  ollama pull qwen2.5:14b
#
# OWNCLAW_EXECUTOR_URL=http://localhost:11434
# OWNCLAW_EXECUTOR_MODEL=qwen2.5:14b

# ---------------------------------------------------------------------------
# OPTIONAL — Paths (usually left as defaults)
# ---------------------------------------------------------------------------
# OWNCLAW_DATABASE_PATH=./data/ownclaw.db
# OWNCLAW_SKILLS_CORE_PATH=./skills/core
# OWNCLAW_SKILLS_GENERATED_PATH=./skills/generated

# ---------------------------------------------------------------------------
# OPTIONAL — Java tuning
# ---------------------------------------------------------------------------
# Extra JVM options (heap size, GC, etc.)
# JAVA_OPTS=-Xmx512m -Xms256m
