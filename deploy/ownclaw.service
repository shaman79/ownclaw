[Unit]
Description=OwnClaw Autonomous AI Agent
Documentation=https://github.com/shaman79/ownclaw
After=network.target
Wants=network.target

[Service]
Type=simple
User=ownclaw
Group=ownclaw
WorkingDirectory=/opt/ownclaw
ExecStart=/opt/ownclaw/jdk/bin/java -jar /opt/ownclaw/ownclaw.jar --server.port=8080
ExecStop=/bin/kill -SIGTERM $MAINPID

# Environment
EnvironmentFile=-/opt/ownclaw/.env

# Graceful shutdown (30s)
TimeoutStopSec=30
KillSignal=SIGTERM

# Auto-restart on crash
Restart=on-failure
RestartSec=10

# Security hardening
# NOTE: NoNewPrivileges is intentionally OFF so that Podman rootless can
# create user namespaces for container-based skill sandboxing.
# Container isolation replaces the privilege restriction.
ProtectSystem=strict
# Load-bearing for skill isolation: the jail shows skills the host read-only as this unit sees
# it, so this is what keeps /home and /root out of their sight. It hides /run/user too, where
# the service user's systemd user manager would start a process outside any jail; the jail
# hides all of /run itself as well. Do not remove it.
ProtectHome=true
# Only what the service writes at runtime. The repo, this unit file and deploy.sh are
# root-owned and deliberately NOT writable: the service runs LLM-generated code, and
# a writable unit file plus the old sudoers grants was a direct path to root.
ReadWritePaths=/opt/ownclaw/data /opt/ownclaw/skills /opt/ownclaw/logs /opt/ownclaw/backups
PrivateTmp=true
# Skill isolation (SkillJail) runs each skill under unprivileged bubblewrap, which needs to
# create user, mount and PID namespaces and to mount a fresh /proc -- and the kernel refuses a
# fresh /proc while the service's own /proc has anything mounted over it. So this unit must NOT
# gain ProtectKernelTunables, ProtectProc, ProcSubset, PrivateUsers, RestrictNamespaces, or a
# SystemCallFilter that blocks unshare/mount. Adding one is caught, not silent: the log says
# why. auto runs skills unjailed with a warning only while bubblewrap cannot start a jail at
# all, and only until the jail has worked once in the process; a self-check that runs but fails
# an item refuses every launch, in auto as in required.
# NoNewPrivileges can stay as it is; bubblewrap sets no_new_privs for the skill itself.

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ownclaw

[Install]
WantedBy=multi-user.target
